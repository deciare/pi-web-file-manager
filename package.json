{
  "name": "@house/pi-web-file-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "General filesystem browser, editor, and file manager for PI WEB",
  "pi": {
    "extensions": []
  },
  "piWeb": {
    "plugins": [
      {
        "id": "file-manager",
        "browserRoot": "browser",
        "module": "browser/pi-web-plugin.js",
        "serverModule": "server-plugin.js",
        "machineSpecific": true
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "install:package": "node scripts/install.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/yazl": "^3.3.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.10.8",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.1",
    "lit": "^3.2.1",
    "yazl": "^3.3.1"
  }
}
